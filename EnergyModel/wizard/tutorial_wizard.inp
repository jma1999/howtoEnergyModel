"Cust 1 Elec Uniform Blk1" = BLOCK-CHARGE    
   BLOCK-SCH        = "Cust 1 Elec Season Sched"
   SCH-FLAG         = 1
   BLOCK1-TYPE      = ENERGY
   BLOCKS-1         = ( 1 )
   COSTS-1          = ( 0.12 )
   ..


$ ---------------------------------------------------------
$              Utility Rates
$ ---------------------------------------------------------

"Custom Elec Rate" = UTILITY-RATE    
   TYPE             = ELECTRICITY
   BLOCK-CHARGES    = ( "Cust 1 Elec Uniform Blk1" )
   ..


